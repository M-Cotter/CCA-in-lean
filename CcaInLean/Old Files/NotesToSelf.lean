/-
import Mathlib.RingTheory.MvPolynomial.Ideal

namespace MvPolynomial

noncomputable
abbrev MonomialIdeal (σ R : Type*) [CommRing R] [Nontrivial R]
  (s : Set (σ →₀ ℕ)) : Ideal (MvPolynomial σ R) :=
  Ideal.span ((fun exp ↦ monomial exp (1 : R)) '' s)

variable [CommSemiring R]

/-- `x` is in a monomial ideal generated by `s` iff every element of its support dominates one of
the generators. Note that `si ≤ xi` is analogous to saying that the monomial corresponding to `si`
divides the monomial corresponding to `xi`. -/
-- mem_ideal_span_monomial_image1
example {x : MvPolynomial σ R} {s : Set (σ →₀ ℕ)} :
    x ∈ Ideal.span ((fun s => monomial s (1 : R)) '' s) ↔ ∀ xi ∈ x.support, ∃ si ∈ s, si ≤ xi := by
  refine AddMonoidAlgebra.mem_ideal_span_of'_image.trans ?_
  simp_rw [le_iff_exists_add, add_comm]
  rfl

-- mem_ideal_span_monomial_image_iff_dvd
example {x : MvPolynomial σ R} {s : Set (σ →₀ ℕ)} :
    x ∈ Ideal.span ((fun s => monomial s (1 : R)) '' s) ↔
      ∀ xi ∈ x.support, ∃ si ∈ s, monomial si 1 ∣ monomial xi (x.coeff xi) := by
  refine mem_ideal_span_monomial_image.trans (forall₂_congr fun xi hxi => ?_)
  simp_rw [monomial_dvd_monomial, one_dvd, and_true, mem_support_iff.mp hxi, false_or]

/-- `x` is in a monomial ideal generated by variables `X` iff every element of its support
has a component in `s`. -/
-- mem_ideal_span_X_image
example {x : MvPolynomial σ R} {s : Set σ} :
    x ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) ↔
      ∀ m ∈ x.support, ∃ i ∈ s, (m : σ →₀ ℕ) i ≠ 0 := by
  have := @mem_ideal_span_monomial_image σ R _ x ((fun i => Finsupp.single i 1) '' s)
  rw [Set.image_image] at this
  refine this.trans ?_
  simp [Nat.one_le_iff_ne_zero]

end MvPolynomial
-/
/-
/-- The minimal elements in the partial order are the smallest generating set of
  a monomial ideal. -/
theorem minimal_unique [Finite σ] (s : Set (σ →₀ ℕ)) (s1 : Finset (σ →₀ ℕ)) :
    MonomialIdeal σ R s = MonomialIdeal σ R s1 →
    Finset.card s1 ≤ Finset.card (Set.Finite.toFinset (minimal_finite s)) →
    s1 = {m | Minimal (· ∈ s) m} := by
  intro hMonoEq hCardLe
  rw [← monomial_ideal_minimal_eq] at hMonoEq
  rcases le_antisymm_iff.mp hMonoEq with ⟨h1, h2⟩
  rw [← monomial_ideal_le_monomial_ideal] at h1 h2
  let sf := Set.Finite.toFinset (minimal_finite s)
  rw [← Set.Finite.coe_toFinset (minimal_finite s), SetLike.coe_set_eq]
  symm
  apply (Finset.subset_iff_eq_of_card_le (hCardLe)).mp
  intro x hxsf
  simp only [Set.mem_setOf_eq, SetLike.mem_coe, Set.Finite.mem_toFinset] at h1 h2 hxsf
  rcases h1 x hxsf with ⟨a, b⟩
  rcases h2 a b.1 with ⟨c, d⟩
  have : c = x := le_antisymm (le_trans d.2 b.2) (hxsf.2 d.1.1 (le_trans d.2 b.2))
  have : a = x := by
    apply le_antisymm b.2
    rw [← this]
    exact d.2
  rw [← this]
  exact b.1
-/
