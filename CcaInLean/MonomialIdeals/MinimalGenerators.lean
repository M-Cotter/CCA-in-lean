module

import CcaInLean.MonomialIdeals.Monomial
import Mathlib
public import Mathlib.Order.WellQuasiOrder
/-!
# MINIMAL GENERATORS

This file defines the basic structure of monomial ideals, in particular we related the
structure of monomials to that of their exponent vector.

# MAIN RESULTS

# TODO

Prove some more stuff about minimal generators of addition and multiplication of ideals
and intersection possibly.
-/

variable {σ R : Type*} [CommRing R] [Nontrivial R]

namespace Monomial
open MvPolynomial
open Monomial

/-- For a set `s` of monomials, the monomial ideal generated by the
  minimal elements (in the division, or equivalently mapping partial order) of
  `s` is equal to the monomial ideal generated by `s`. -/
theorem monomial_ideal_minimal_eq (s : Set (σ →₀ ℕ)) :
    MonomialIdeal σ R {m | Minimal (· ∈ s) m} = MonomialIdeal σ R s := by
  apply le_antisymm
  · rw [← monomial_ideal_le_monomial_ideal]
    intro m ms
    use m
    exact ⟨Set.mem_of_mem_inter_left ms, Std.le_refl _⟩
  · rw [← Monomial.monomial_ideal_le_monomial_ideal]
    intro m ms
    let sm := {x ∈ s | x ≤ m}
    obtain ⟨a, ha⟩ := WellFounded.has_min (Finsupp.lt_wf σ) sm ⟨m, ms, le_refl _⟩
    use a
    rw [Set.mem_setOf_eq]
    constructor
    · constructor
      · exact ha.1.1
      · intro y hy hya
        by_contra
        apply ha.2 y
        · rw [Set.mem_setOf_eq]
          exact ⟨hy, le_trans hya ha.1.2⟩
        rcases eq_or_lt_of_le hya with heq | hle
        · by_contra h
          apply this
          rw [heq]
        · exact hle
    · exact ha.1.2

/- The next results uses Dickson's lemma about the well-quasiordered-ness of maps from
a finite set to a well ordered set. -/

/-- The set of minimal monomials in a set `s` of monomials over a finite number of variables
 is finite. -/
theorem minimal_finite [Finite σ] (s : Set (σ →₀ ℕ)) :
    {m | Minimal (· ∈ s) m}.Finite := by
  have h : IsAntichain (· ≤ ·) {m | Minimal (· ∈ s) m} := by
    intro a ha b hb haneqb haleb
    simp only [minimal_iff, Set.mem_setOf_eq] at ha hb
    apply haneqb
    symm
    apply hb.2 ha.1 haleb
  exact WellQuasiOrderedLE.finite_of_isAntichain h

/-- If two sets of monomials generate the same monomial ideal then their minimal
  elements are equal. -/
theorem monomial_ideals_equal_same_minimal [Finite σ] (s t : Set (σ →₀ ℕ)) :
    MonomialIdeal σ R s = MonomialIdeal σ R t →
    {m | Minimal (· ∈ s) m} = {m | Minimal (· ∈ t) m} := by
  intro hseqt
  rw [← monomial_ideal_minimal_eq, ← monomial_ideal_minimal_eq t,
       ← monomial_ideal_eq_monomial_ideal] at hseqt
  ext x
  constructor <;> intro hx
  · rcases hseqt.1 x hx with ⟨a, ha⟩
    rcases hseqt.2 a ha.1 with ⟨b, hb⟩
    have hxeqb : x = b := le_antisymm (hx.2 hb.1.1 (le_trans hb.2 ha.2)) (le_trans hb.2 ha.2)
    have haeqb : a = b := by
      rw [hxeqb] at ha
      exact le_antisymm ha.2 hb.2
    rw [hxeqb, ← haeqb]
    exact ha.1
  · rcases hseqt.2 x hx with ⟨a, ha⟩
    rcases hseqt.1 a ha.1 with ⟨b, hb⟩
    have hxeqb : x = b := le_antisymm (hx.2 hb.1.1 (le_trans hb.2 ha.2)) (le_trans hb.2 ha.2)
    have haeqb : a = b := by
      rw [hxeqb] at ha
      exact le_antisymm ha.2 hb.2
    rw [hxeqb, ← haeqb]
    exact ha.1

/- I used to have a lemma here about the minimal set being the smallest (in terms of
  cardinality) generator of a given monomial ideal. I don't think it really has a use case
  though so I moved it to `Old Files/NotesToSelf.lean`. -/

/-- If `s` and `t` are sets of monomials, the minimal elements of `s ∪ t` are contained
  in the minimal elements of `s` and `t` combined. -/
theorem minimal_union_subset_union_minimal (s t : Set (σ →₀ ℕ)) :
    {m | Minimal (· ∈ (s ∪ t)) m} ⊆
    {m | Minimal (· ∈ s) m} ∪ {m | Minimal (· ∈ t) m} := by
  intro x hx
  simp only [Set.mem_union, Set.mem_setOf_eq] at *
  exact Minimal.or hx

end Monomial
