import CcaInLean.MonomialIdeals.Monomial
import CcaInLean.MonomialIdeals.MinimalGenerators
import Mathlib
variable {σ R : Type*} [CommRing R] [Nontrivial R] [DecidableEq σ]

open MvPolynomial
namespace Monomial

/-- Given a finite set of vertices we define a squarefree monomial (face) as a the collection
  of all vertices (as indeterminates) multiplied together. -/
noncomputable
def SqFreeMono : Finset σ → (σ →₀ ℕ) :=
  fun s ↦
    {
      support := s
      toFun := Set.indicator s (fun x ↦ 1)
      mem_support_toFun := by simp only [ne_eq, Set.indicator_apply_eq_zero, SetLike.mem_coe,
        one_ne_zero, imp_false, Decidable.not_not, implies_true]
    }

/- Given a set of finite sets of vertices (no restriction), the monomial ideal
    generated by the corresponding faces (as monomials). -/
noncomputable
def SquareFreeIdeal (σ R : Type*) (S : Set (Finset σ))
    [CommRing R] [Nontrivial R] [DecidableEq σ] : Ideal (MvPolynomial σ R) :=
  MonomialIdeal σ R (SqFreeMono '' S)

/-- The squarefree monomials corresponding to the face `a` divides that corresponding
  to the face `b` if and only if `a` is contained in `b`. -/
theorem sq_free_mono_le_iff (a b : Finset σ) :
    SqFreeMono a ≤ SqFreeMono b ↔ a ≤ b := by
  unfold SqFreeMono
  constructor <;> intro h x
  · intro hxa
    unfold Set.indicator LE.le Finsupp.instLE  at h
    dsimp at h
    have : (if x ∈ a then 1 else 0) ≤ if x ∈ ↑b then 1 else 0 := by
      simp only [SetLike.mem_coe] at h; apply h
    simp only [hxa, ↓reduceIte] at this
    by_cases hb : x ∈ b
    · exact hb
    · simp only [hb, ↓reduceIte, nonpos_iff_eq_zero, one_ne_zero] at this
  · simp only [Finsupp.coe_mk]
    by_cases hxa : x ∈ a
    · simp [SetLike.mem_coe, hxa, h hxa]
    · simp [SetLike.mem_coe, hxa]

/-- A squarefree monomial constructed from the face `sf` is in a squarefree
    monomial ideal if and only if one of the generating faces of that
    squarefree monomial ideal is a superset of `sf`. -/
theorem sq_free_mono_mem_iff (S : Set (Finset σ)) (sf : Finset σ) :
    (∃ s ∈ S, s ≤ sf) ↔ (SqFreeMono sf : MvPolynomial σ R) ∈ SquareFreeIdeal σ R S := by
  unfold SquareFreeIdeal
  rw [mem_monomial_ideal_iff]
  constructor <;> rintro ⟨a, ha⟩
  · use SqFreeMono a
    constructor
    · rw [Set.mem_image]
      exact ⟨a, ha.1, rfl⟩
    · rw [sq_free_mono_le_iff]
      exact ha.2
  · rcases ha.1 with ⟨b, hb⟩
    use b
    constructor
    · exact hb.1
    · intro x hx
      rw [← hb.2, sq_free_mono_le_iff] at ha
      exact ha.2 hx

/-- The root of a monomial. For instance, ` MonoRoot x⁸y² = xy`. -/
noncomputable
def MonoRoot (m : σ →₀ ℕ) : σ →₀ ℕ :=
  {
    support := m.support
    toFun := fun x ↦ if m x = 0 then 0 else 1
    mem_support_toFun := by simp only [Finsupp.mem_support_iff, ne_eq, ite_eq_left_iff, one_ne_zero,
      imp_false, Decidable.not_not, implies_true]
  }

/-- Implication that if a monomial `m` divides a monomial `n`, then `MonoRoot m` divives
  `MonoRoot n` -/
lemma mono_le_mono_root_le {σ : Type*} (m n : σ →₀ ℕ) :
    m ≤ n → MonoRoot m ≤ n := by
  intro hmn i
  by_cases h : m i = 0
  · unfold MonoRoot
    simp only [Finsupp.coe_mk, h, ↓reduceIte, zero_le]
  · unfold MonoRoot
    simp only [Finsupp.coe_mk, h, ↓reduceIte]
    calc
      1 ≤ m i := Nat.one_le_iff_ne_zero.mpr h
      _ ≤ n i := hmn i

/-- The root of a monomial `m` divivdes `m`. -/
lemma mono_root_le {σ : Type*} (m : σ →₀ ℕ) :
    MonoRoot m ≤ m := mono_le_mono_root_le _ _ (le_refl _)

/-- A monomial ideal generated by `s` is contained in the the monomial ideal
    generated by the roots of `s`. -/
theorem monomial_ideal_le_monomial_ideal_mono_root {σ : Type*} (s : Set (σ →₀ ℕ)) :
    MonomialIdeal σ R s ≤ MonomialIdeal σ R (MonoRoot '' s) := by
  rw [← monomial_ideal_le_monomial_ideal]
  intro m hm
  simp only [Set.mem_image, exists_exists_and_eq_and]
  use m
  exact ⟨hm, mono_le_mono_root_le _ _ (le_refl m)⟩

/-- The root of a monomial `n` divides a monomial `m` if and only if there exists a
  natural number `k` such that `n` divides `m ^ k`. -/
theorem mono_root_le_iff {σ : Type*} (m n : σ →₀ ℕ) :
    (∃ k : ℕ, n ≤ k • m) ↔ MonoRoot n ≤ m := by
  constructor <;> intro h
  · intro i
    rcases h with ⟨c, hc⟩
    unfold MonoRoot
    rw [Finsupp.coe_mk]
    by_cases hni : n i = 0
    · rw [if_pos hni]
      omega
    · rw [if_neg hni]
      have : 1 ≤ c * m i := by
        calc
          1 ≤ n i := by simpa only [Nat.one_le_iff_ne_zero]
          _ ≤ c * m i := hc i
      rw [Nat.one_le_iff_ne_zero] at this ⊢
      intro hmi
      apply this
      rw [hmi, mul_zero]
  · use n.support.sup n
    intro i
    by_cases hni : n i = 0
    · rw [hni]
      exact Nat.zero_le _
    · rw [@Finsupp.nsmul_apply, smul_eq_mul]
      have a1 : MonoRoot n i = 1 := by
        unfold MonoRoot
        simpa only [Finsupp.coe_mk, ite_eq_right_iff, zero_ne_one, imp_false]
      have : 1 ≤ m i := by rw [← a1]; apply h
      calc
        _ ≤ n.support.sup n := by
          apply Finset.le_sup
          rwa [Finsupp.mem_support_iff, ne_eq]
        _ ≤ n.support.sup n * m i := Nat.le_mul_of_pos_right (n.support.sup ⇑n) (this)

theorem mono_root_le_iff_support {σ : Type*} (m n : σ →₀ ℕ) :
    n.support ≤ m.support ↔ MonoRoot n ≤ m := by
  unfold MonoRoot
  constructor <;> intro h i
  · simp only [Finsupp.coe_mk]
    by_cases g : n i = 0
    rw [if_pos g]
    exact Nat.zero_le _
    rw [if_neg g, Nat.one_le_iff_ne_zero, ← Finsupp.mem_support_iff]
    rw [← ne_eq, ← Finsupp.mem_support_iff] at g
    exact h g
  · intro hi
    by_cases g : n i = 0
    rw [Finsupp.mem_support_iff] at hi
    contradiction
    rw [Finsupp.mem_support_iff, ← Nat.one_le_iff_ne_zero]
    sorry

theorem mono_root_smul_le {σ : Type*} (m : σ →₀ ℕ) (k : ℕ) :
    MonoRoot (k • m) ≤ MonoRoot m := by
  intro i
  unfold MonoRoot
  simp only [Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, mul_eq_zero, Finsupp.coe_mk]
  grind only [#d8aa]

theorem mono_root_mono {σ : Type*} (m n : σ →₀ ℕ) (hmn : m ≤ n) :
    MonoRoot m ≤ MonoRoot n := by
  intro i
  unfold MonoRoot
  simp only [Finsupp.coe_mk]
  by_cases h : m i = 0
  · rw [if_pos h]
    · by_cases g : n i = 0
      · rw [if_pos g]
      · rw [if_neg g]; norm_num
  · rw [if_neg h]
    by_cases g : n i = 0
    · exfalso
      rw [← le_zero_iff, ← g] at h
      exact h (hmn i)
    · rw [if_neg g]

/-- A monomial `m` is in the radical of the monomial ideal of `s` if and only if
    there is an element of `s` whose root divides `m`. -/
theorem mem_radical_monomial_iff {σ : Type*} (s : Set (σ →₀ ℕ)) (m : σ →₀ ℕ) :
    (m : MvPolynomial σ R) ∈ Ideal.radical (MonomialIdeal σ R s) ↔
    ∃ x ∈ s, MonoRoot x ≤ m := by
  rw [Ideal.mem_radical_iff]
  constructor <;> rintro ⟨n, hn⟩
  · rw [monomial_pow, one_pow, mem_monomial_ideal_iff] at hn
    rcases hn with ⟨l, hl⟩
    use l
    rw [← mono_root_le_iff]
    exact ⟨hl.1, n, hl.2⟩
  · rw [← mono_root_le_iff] at hn
    rcases hn.2 with ⟨k, hk⟩
    use k
    rw [monomial_pow, one_pow, mem_monomial_ideal_iff]
    exact ⟨n, hn.1, hk⟩

/-- Root of a root is itself. -/
theorem mono_root_mono_root {σ : Type*} (m : σ →₀ ℕ) :
    MonoRoot (MonoRoot m) = MonoRoot m := by
  unfold MonoRoot
  simp only [Finsupp.coe_mk, ite_eq_left_iff, one_ne_zero, imp_false, Decidable.not_not]

variable [DecidableEq σ]

/- Decidable equality is used I don't know why lean is complaining. -/
/-- Root of a squarefree monomial is itself. -/
theorem mono_root_sqfreemono (s : Finset σ) :
    MonoRoot (SqFreeMono s) = SqFreeMono s := by
  unfold MonoRoot SqFreeMono Set.indicator
  simp only [SetLike.mem_coe, Finsupp.coe_mk, ite_eq_right_iff, one_ne_zero, imp_false,
    Finsupp.mk.injEq, true_and]
  ext x
  grind only

open scoped MonomialOrder

/-- If we have a product of `n` monomials in `s`, multiplying to a minimal element
  then each is the minimal element. -/
theorem sum_to_minimal (s : Set (σ →₀ ℕ)) (m : MonomialOrder σ)
    (ha : ∀ x ∈ s, (a ≼[m] x)) (n : ℕ) :
    ∀ f : Fin n → σ →₀ ℕ, (∀ i : Fin n, f i ∈ s) → n • a ≼[m] ∑ i : Fin n, f i := by
  induction n with
  | zero =>
    intro f hf
    simp only [zero_nsmul, map_zero, Finset.univ_eq_empty, Finset.sum_empty, Std.le_refl]
  | succ k hk =>
    intro f hf
    rw [add_smul, one_smul, map_add, Fin.sum_univ_succ, map_add, add_comm]
    apply add_le_add
    · by_cases h : f 0 ≼[m] a
      exact ha (f 0) (hf 0)
      exact le_of_eq_of_le rfl (ha (f 0) (hf 0))
    · apply hk
      sorry

theorem support_le_support_sum (a b : σ →₀ ℕ) :
    a.support ≤ (a + b).support := by
  intro i hi
  rw [Finsupp.mem_support_iff, ← Nat.one_le_iff_ne_zero] at hi ⊢
  apply le_trans hi
  rw [@Finsupp.add_apply]
  exact Nat.le_add_right (a i) (b i)

theorem support_smul (a : σ →₀ ℕ) (n : ℕ) :
    ((n + 1) • a).support = a.support := by
  ext i
  rw [Finsupp.mem_support_iff, Finsupp.mem_support_iff, Finsupp.smul_apply]
  grind only [#bbd0]

/-- Support of the sum of some elements (or a multiple of the sum, which is more
conducive to our goal) has greater support than the summands. -/
theorem support_summand_le_sum_support (n : ℕ) (f : Fin n → (σ →₀ ℕ)) :
    ∀ i : Fin n, (f i).support ≤ (∑ i : Fin n, f i).support := by
  induction n with
  | zero => simp only [IsEmpty.forall_iff]
  | succ k hk =>
    intro i x hx
    rw [Finsupp.mem_support_iff] at ⊢ hx
    rw [← Nat.one_le_iff_ne_zero] at ⊢ hx
    calc
      1 ≤ (f i x) := hx
      _ ≤ (∑ i, f i) x := by
        rw [Finset.sum_apply']
        have hi : i ∈ (Finset.univ : Finset (Fin (k + 1))) := by simp
        apply Finset.single_le_sum (s := (Finset.univ : Finset (Fin (k + 1))))
            (f := fun j ↦ (f j) x)
        · exact fun i a ↦ Nat.zero_le _
        · exact hi

/- This is a subset relation but not an equality though this shouldn't be an issue. -/
/-- Support of a polynomial power is a subset of the sum combinations of monomials. -/
theorem pow_support (p : MvPolynomial σ R) (n : ℕ) :
    (p ^ n).support ≤
    {x : σ →₀ ℕ | ∃ f : Fin n → (σ →₀ ℕ), (∀ i, f i ∈ p.support) ∧ ∑ i, f i = x} := by
  induction n with
  | zero =>
    rw [pow_zero, support_one]
    intro xi hxi
    rw [Finset.coe_singleton, Set.mem_singleton_iff] at hxi
    simp only [IsEmpty.forall_iff, Finset.univ_eq_empty, Finset.sum_empty,
      true_and, exists_const, Set.setOf_eq_eq_singleton', hxi, Set.mem_singleton_iff]
  | succ k hk =>
    intro xi hxi
    rw [Set.mem_setOf_eq]
    rw [pow_succ] at hxi
    apply support_mul at hxi
    rw [Finset.mem_add] at hxi
    rcases hxi with ⟨a, ha, b, hb, hab⟩
    rcases hk ha with ⟨f, hf⟩
    use Fin.snoc f b
    constructor
    · intro i
      cases i using Fin.lastCases
      · rwa [Fin.snoc_last]
      · rw [Fin.snoc_castSucc]
        exact hf.1 _
    · rw [@Fin.sum_snoc, hf.2, hab]

/- This is the best we can do, consider any non-radical ring, then the
  radical of the monomial ideal `(0)` contains an zero-root we want. It is impossible
  for a zero root to be a monomial (in a nontrivial ring) so the radical of `(0)` is
  not a monomial ideal.

  I have monomial order in the hypotheses, this is to make it easier to formalize some
  sense of minima without coding deg-lex or something myself. Maybe we can put a local
  instance of MonomialOrder on an arbitrary `σ` in the following manner?

    noncomputable
    instance : LinearOrder σ := by
    classical
    exact linearOrderOfSTO WellOrderingRel

    noncomputable
    instance : LinearOrder (σ →₀ ℕ) := Finsupp.DegLex.instLinearOrderDegLexNat

  Zeromelo's theorem is not necessary since we could (theoretically) just put an order
  on the finite number of variables in any finite set after which is possible without
  choice. However, this might be hard to do.

  The basic idea for the proof is that we have two orders on the support of a polynomial
  that by inclusion of supports of each monomial (NOT OF THE POLYNOMIAL), and a monomial
  order. For each monomial in the support of a polynomial, we pick the minima in the
  set of elements which have their support contained in the first monomial. This is a
  multiplication invariant so this coefficient will be preserved under taking the power.
  I can probably explain this better later.
-/

/-- For a reduced ring the radical of a monomial ideal is the monomial ideal of its monomial
roots.-/
theorem monomial_ideal_radical_eq [IsReduced R] (s : Set (σ →₀ ℕ)) (m : MonomialOrder σ) :
    Ideal.radical (MonomialIdeal σ R s) =
    MonomialIdeal σ R (MonoRoot '' s) := by
  apply le_antisymm
  · intro p ⟨k, hp⟩
    rw [mem_ideal_span_monomial_image] at hp ⊢
    intro xi hxi
    have : ∃ yi ∈ (p ^ k).support, MonoRoot yi ≤ xi := by
      let A : Set (σ →₀ ℕ) := {m ∈ p.support | m.support ≤ xi.support}
      have : A.Nonempty := ⟨xi, hxi, le_refl _⟩
      obtain ⟨w, ⟨wi, hwi⟩, hw⟩ := WellFounded.has_min m.wf.wf (m.toSyn '' A) (Set.Nonempty.image _ this)
      use k • wi
      rw [Set.mem_setOf_eq] at hwi
      constructor
      · have (k : ℕ) : coeff (k • wi) (p ^ k) = (coeff (wi) p) ^ k := by
          induction k with
          | zero => rw [zero_smul, pow_zero, pow_zero, coeff_one, if_pos]; rfl
          | succ i hi =>
            rw [pow_succ, coeff_mul]
            have : {⟨i • wi, wi⟩} ⊆ Finset.antidiagonal ((i + 1) • wi) := by
              rw [Finset.singleton_subset_iff, Finset.mem_antidiagonal, add_smul, one_smul]
            rw [← Finset.sum_subset this ?_, Finset.sum_singleton, pow_succ, hi]
            intro x hx hj
            simp only [Set.mem_image, not_lt, forall_exists_index, and_imp,
              forall_apply_eq_imp_iff₂] at hw
            contrapose! hj
            have hx1 : x.1 ∈ (p ^ i).support := by
              rw [mem_support_iff]
              exact left_ne_zero_of_mul hj
            have hx2 : x.2 ∈ p.support := by
              rw [mem_support_iff]
              exact right_ne_zero_of_mul hj
            apply pow_support at hx1
            rw [Finset.mem_antidiagonal, add_smul, one_smul] at hx
            rcases hx1 with ⟨f, hf⟩
            have hfiA : ∀ (j : Fin i), f j ∈ A := by
              intro j
              rw [Set.mem_setOf_eq]
              constructor
              exact hf.1 j
              calc
                _ ≤ x.1.support := by
                    rw [← hf.2]
                    apply support_summand_le_sum_support
                _ ≤ ((i + 1) • wi).support := by
                  rw [add_smul, one_smul, ← hx]
                  exact support_le_support_sum _ _
                _ = wi.support := support_smul _ _
                _ ≤ xi.support := hwi.1.2
            have : x.2 ∈ A := by
              rw [Set.mem_setOf_eq]
              constructor
              exact hx2
              calc
              _ ≤ ((i + 1) • wi).support := by
                rw [add_smul, one_smul, ← hx, add_comm]
                exact support_le_support_sum _ _
              _ = wi.support := support_smul _ _
              _ ≤ xi.support := hwi.1.2
            have : wi ≼[m] x.2 := by
              rw [hwi.2]
              apply hw
              exact this
            have x1le : x.1 ≼[m] i • wi := by
              suffices x.1 + x.2 ≼[m] i • wi + x.2 by
                rw [map_add, map_add] at this
                apply le_of_add_le_add_right this
              rw [hx, map_add, map_add]
              apply add_le_add_right
              exact this
            have x1ge : i • wi ≼[m] x.1 := by
              rw [← hf.2]
              apply sum_to_minimal
              rw [hwi.2]
              exact hw
              exact hfiA
            have x1eq : i • wi = x.1 := m.toSyn.injective (le_antisymm x1ge x1le)
            have x2eq : x.2 = wi := by
              rw [x1eq] at hx
              exact add_left_cancel hx
            rw [x1eq, ← x2eq]
            simp only [Prod.mk.eta, Finset.mem_singleton]
        rw [mem_support_iff, this, ne_eq, pow_eq_zero_iff']
        intro ⟨hp, _⟩
        rw [mem_support_iff] at hwi
        exact hwi.1.1 hp
      · calc
        _ ≤ MonoRoot wi := mono_root_smul_le _ _
        _ ≤ xi := by rw [← mono_root_le_iff_support]; exact hwi.1.2
    rcases this with ⟨yi, hyi⟩
    rcases hp yi hyi.1 with ⟨zi, hzi⟩
    use MonoRoot zi
    constructor
    exact ⟨zi, hzi.1, rfl⟩
    calc
      MonoRoot zi ≤ MonoRoot yi := mono_root_mono _ _ hzi.2
      _ ≤ xi := hyi.2
  · intro p hp
    suffices ∀ xi ∈ p.support, (xi : MvPolynomial σ R) ∈ (MonomialIdeal σ R s).radical by sorry
    intro xi hxi
    rw [mem_radical_monomial_iff]
    rw [mem_ideal_span_monomial_image] at hp
    rcases hp xi hxi with ⟨a, ⟨b, hb⟩, ha1⟩
    use b
    rw [hb.2]
    exact ⟨hb.1, ha1⟩
